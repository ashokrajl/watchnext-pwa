# Supabase — get these from your project's Settings > API Keys page.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# TMDB API proxy — defaults to /api/tmdb (works on Vercel).
# Set this if you want to point at a specific deployed URL during local dev.
# VITE_API_BASE=https://your-app.vercel.app/api/tmdb

# Server-side only (Vercel serverless function, never exposed to the browser)
TMDB_BEARER=your_tmdb_bearer_token
